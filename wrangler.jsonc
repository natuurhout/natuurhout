{
  // Natuurhout — static Next.js export (./out) served as Workers static assets.
  // worker/index.ts runs first for every request: trailing-slash + next.config.ts redirects (308s,
  // same as Next on Vercel) and POST /api/offerte/ (quote requests → Cloudflare Email Sending). See AGENTS.md "Hosting".
  // Build: `npm run build`. Deploy: `npm run deploy`. No secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natuurhout",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // quote-email.ts uses Buffer for photo attachments.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  // Quote/order mails go out from offerte@natuurhout.be via Email Sending (enable the domain with
  // `npx wrangler email sending enable natuurhout.be` once the zone is active).
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["offerte@natuurhout.be"] }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Production domains (Cloudflare zone natuurhout.be). The apex 301s to www in worker/index.ts.
  "routes": [
    { "pattern": "www.natuurhout.be", "custom_domain": true },
    { "pattern": "natuurhout.be", "custom_domain": true }
  ],
  // Keep the workers.dev staging URL until the Combell nameserver switch is verified, then set false.
  // The Worker sends X-Robots-Tag: noindex on *.workers.dev so the staging copy is never indexed.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
