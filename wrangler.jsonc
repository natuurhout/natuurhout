{
  // Natuurhout — static Next.js export (./out) served as Workers static assets.
  // worker/index.ts runs first for every request: trailing-slash + next.config.ts redirects (308s,
  // same as Next on Vercel) and POST /api/offerte/ (quote requests → Resend). See AGENTS.md "Hosting".
  // Build: `npm run build`. Deploy: `npm run deploy`. Secret (never committed): RESEND_API_KEY.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natuurhout",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // quote-email.ts uses Buffer for photo attachments.
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Staging copy until the natuurhout.be cutover (WordPress at Combell stays production).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
